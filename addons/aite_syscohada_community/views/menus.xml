    <menuitem id="menu_open_flux" name="Tableau des flux de trésorerie" parent="l10n_syscohada.account_reports_syscohada_statements_menu"
              action="action_open_flux" sequence="13" groups="account.group_account_readonly"/>
    <menuitem id="menu_vat_declaration" name="Déclarations de TVA (Cameroun)"
