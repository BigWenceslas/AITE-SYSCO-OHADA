<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_open_actif" model="ir.actions.server">
        <field name="name">SYSCOHADA – Bilan actif</field>
        <field name="model_id" ref="mis_builder.model_mis_report_instance"/>
        <field name="state">code</field>
        <field name="code">action = model._aite_syscohada_open("actif")</field>
    </record>
    <record id="action_open_passif" model="ir.actions.server">
        <field name="name">SYSCOHADA – Bilan passif</field>
        <field name="model_id" ref="mis_builder.model_mis_report_instance"/>
