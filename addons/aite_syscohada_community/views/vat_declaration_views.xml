<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_aite_cm_vat_declaration_list" model="ir.ui.view">
        <field name="name">aite.cm.vat.declaration.list</field>
        <field name="model">aite.cm.vat.declaration</field>
        <field name="arch" type="xml">
            <list>
                <field name="currency_id" column_invisible="1"/>
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="vat_collected" sum="Total"/>
                <field name="vat_deductible"/>
                <field name="vat_to_pay" sum="Total"/>
                <field name="credit_to_report"/>
                <field name="total_to_pay" sum="Total"/>
                <field name="date_due"/>
                <field name="move_id"/>
                <field name="state" widget="badge" decoration-success="state == 'done'"/>
            </list>
        </field>
    </record>
    <record id="view_aite_cm_vat_declaration_form" model="ir.ui.view">
        <field name="name">aite.cm.vat.declaration.form</field>
        <field name="model">aite.cm.vat.declaration</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_compute" type="object" string="Calculer" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_create_closing_entry" type="object" string="Passer l'écriture de liquidation"
                            invisible="state != 'draft' or move_id"/>
                    <button name="action_done" type="object" string="Valider" invisible="state != 'draft'"/>
                    <button name="action_draft" type="object" string="Remettre en brouillon" invisible="state != 'done'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_move" type="object" class="oe_stat_button" icon="fa-book"
                                invisible="not move_id" string="Écriture"/>
                    </div>
                    <h1><field name="name"/></h1>
                    <group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company" readonly="state == 'done'"/>
                            <field name="date_from" readonly="state == 'done'"/>
                            <field name="date_to" readonly="state == 'done'"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="vat_collected"/>
                            <field name="vat_deductible"/>
                            <field name="vat_to_pay"/>
                            <field name="vat_credit"/>
                            <field name="credit_to_report"/>
                            <field name="acompte_to_pay"/>
                            <field name="total_to_pay" class="fw-bold"/>
                            <field name="date_due"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Déclaration I/TVA-IR" name="lines">
                            <field name="line_ids" readonly="1">
                                <list decoration-bf="level == 0" limit="100">
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="level" column_invisible="1"/>
                                    <field name="has_base" column_invisible="1"/>
                                    <field name="has_tax" column_invisible="1"/>
                                    <field name="name"/>
                                    <field name="base" invisible="not has_base"/>
                                    <field name="tax" invisible="not has_tax"/>
                                </list>
                            </field>
                        </page>
                        <page string="Retenues, acomptes, IRCM, salaires" name="itvair">
                            <field name="itvair_line_ids">
                                <list editable="bottom" create="0" delete="0" limit="100" decoration-bf="kind == 'formula'"
                                      decoration-muted="not editable and kind != 'formula' and total == 0">
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="kind" column_invisible="1"/>
                                    <field name="editable" column_invisible="1"/>
                                    <field name="section"/>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="base_input" readonly="not editable or kind not in ('manual', 'manual_unit', 'acompte')" optional="show"/>
                                    <field name="rate_input" readonly="not editable or kind not in ('manual', 'manual_unit')" optional="show"/>
                                    <field name="amount_input" readonly="not editable or kind not in ('manual_amount', 'carry')" optional="show"/>
                                    <field name="penalty" readonly="not editable and kind != 'credit'" optional="show"/>
                                    <field name="base"/>
                                    <field name="principal"/>
                                    <field name="cac"/>
                                    <field name="total"/>
                                </list>
                            </field>
                        </page>
                        <page string="Saisies du déclarant" name="manual">
                            <group>
                                <group string="Report et remboursement">
                                    <field name="credit_previous" readonly="state == 'done'"/>
                                    <field name="reimbursement" readonly="state == 'done'"/>
                                    <field name="acompte_rate" readonly="state == 'done'"/>
                                    <field name="cac_rate" readonly="state == 'done'"/>
                                </group>
                                <group string="Accises et régularisations">
                                    <field name="excise_base" readonly="state == 'done'"/>
                                    <field name="excise_tax" readonly="state == 'done'"/>
                                    <field name="adj_deductible" readonly="state == 'done'"/>
                                    <field name="adj_state" readonly="state == 'done'"/>
                                    <field name="adj_fixed" readonly="state == 'done'"/>
                                    <field name="adj_other" readonly="state == 'done'"/>
                                    <field name="adjustment_account_id" readonly="state == 'done'"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_aite_cm_vat_declaration" model="ir.actions.act_window">
        <field name="name">Déclarations de TVA (Cameroun)</field>
        <field name="res_model">aite.cm.vat.declaration</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
